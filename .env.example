# Copy to .env. Values below match docker-compose.yml.

# PostgreSQL used by the app, the worker and Prisma.
DATABASE_URL="postgresql://spesasmart:spesasmart@localhost:5432/spesasmart"

# Separate database for integration and end-to-end tests. Tests reset it.
TEST_DATABASE_URL="postgresql://spesasmart:spesasmart@localhost:5432/spesasmart_test"

# Redis used by the ingestion queues.
REDIS_URL="redis://localhost:6379"

# Sent as User-Agent by every ingestion request. Must name a way to reach you.
INGESTION_USER_AGENT="SpesaSmartNL/0.1 (personal project; contact: you@example.com)"

# Comma-separated adapters allowed to make real requests (jumbo,vomar,dirk,ah).
# Empty means no real requests at all: only mock adapters run.
INGESTION_ENABLED_ADAPTERS=""

# Token for the /admin pages: at least 32 random characters (for example `openssl rand -hex 24`).
# Empty or shorter means there is no admin panel at all.
ADMIN_TOKEN=""

# Hosted demo only (docs/deploy.md): session-mode connection the Vercel build uses for migrations.
# DIRECT_URL=""
